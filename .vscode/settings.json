{
  // Live Server: NO recargar las pestañas abiertas cuando se guardan datos.
  // Sin esto, cada escritura del admin (JSON, imágenes, shells HTML de botones)
  // dispara un reload completo que borra el estado del panel.
  // Los cambios de código (HTML/CSS/JS) en carpetas no listadas siguen recargando.
  "liveServer.settings.ignoreFiles": [
    "**/*.json",
    "api/data/**",
    "img/**",
    "html/btn-*/**",
    "html/cliente/**",
    "html/cliente-*/**"
  ]
}
