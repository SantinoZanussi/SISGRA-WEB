{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "-p", "5501", "-c-1", "--cors"],
      "port": 5501
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["api/server.js"],
      "port": 3000
    },
    {
      "name": "api-test",
      "runtimeExecutable": "node",
      "runtimeArgs": ["api/server.js"],
      "port": 3001,
      "env": { "PORT": "3001" }
    }
  ]
}
